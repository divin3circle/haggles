{
  "name": "@haggles/api",
  "version": "0.1.0",
  "description": "Haggles facilitator and portal Fastify API server (SPEC.md sections 3, 5, 6, 7, 8, 9).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate": "bun src/scripts/generate-openapi.ts",
    "openapi:check": "bun src/scripts/generate-openapi.ts --check",
    "db:migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@fastify/under-pressure": "^9.0.2",
    "@haggles/core": "workspace:*",
    "@sinclair/typebox": "^0.34.30",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
