{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Haggles",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "tabler"
  },
