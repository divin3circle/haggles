              "concepts/policies",
              "concepts/lifecycle",
              "concepts/security",
              "concepts/assumptions"
            ]
          },
          {
            "group": "Protocol Reference",
            "pages": [
              "protocol/wire-format",
              "protocol/errors"
            ]
          },
          {
            "group": "Guides & Operations",
            "pages": [
              "guides/paywall-middleware",
              "guides/ai-sdk-agent",
              "guides/going-to-production",
              "operations/self-hosting",
              "operations/runbook",
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "SDK & API Reference",
        "groups": [
