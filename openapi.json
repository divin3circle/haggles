    "/v1/payments/{id}/redeem": {
      "post": {
        "summary": "Redeem (capture) an authorized payment",
        "tags": [
          "protocol"
        ],
        "description": "Verifies the payment token, atomically transitions the payment from authorized to captured, credits the seller net of platform fee, and returns a signed receipt (SPEC.md section 5.1).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "token",
                  "method",
                  "url",
                  "amount"
                ],
                "properties": {
                  "token": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "method": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "url": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "amount": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "route": {
