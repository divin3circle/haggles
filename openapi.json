    "/v1/wallet": {
      "get": {
        "summary": "Read buyer wallet balance and policy allowance",
        "tags": [
          "protocol"
        ],
        "description": "Returns available and held USD balance plus remaining per-call, daily, and monthly policy allowances for the authenticated agent key (SPEC.md sections 5.1 and 10.2).",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "available",
                    "held",
                    "currency",
                    "allowance"
                  ],
                  "properties": {
                    "available": {
                      "type": "string"
                    },
                    "held": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "USD"
                      ]
                    },
                    "allowance": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "per_call_max",
                        "daily_remaining",
                        "monthly_remaining"
                      ],
                      "properties": {
                        "per_call_max": {
                          "type": "string"
                        },
                        "daily_remaining": {
                          "type": "string"
                        },
                        "monthly_remaining": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
