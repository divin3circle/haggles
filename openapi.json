    "/.well-known/jwks.json": {
      "get": {
        "summary": "Public Ed25519 signing keys (JWKS)",
        "tags": [
          "protocol"
        ],
        "description": "Returns active and recently retired Ed25519 public keys used to verify payment tokens and receipts (SPEC.md section 4.6).",
