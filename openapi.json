    "/v1/payments/{id}/refund": {
      "post": {
        "summary": "Refund a captured payment",
        "tags": [
          "protocol"
        ],
        "description": "Refunds a captured payment within 24 hours, returning the gross amount (including platform fee) to the buyer wallet's available balance (SPEC.md sections 5.1, 6.3, 7.4).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "handler_error"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "seller_initiated"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "minLength": 1,
              "type": "string"
