            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "payment_id",
                    "status",
                    "amount",
                    "refunded_at"
                  ],
                  "properties": {
                    "payment_id": {
                      "type": "string"
